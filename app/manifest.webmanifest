{
  "name": "JSE — 악보 인식·편집",
  "short_name": "JSE",
  "description": "악보 사진을 인식해 편집하고 PDF·이미지·MusicXML로 내보내는 악보 프로그램",
  "lang": "ko",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#d9e2fb",
  "theme_color": "#d9e2fb",
  "categories": ["music", "productivity", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-scoresnap": [".ssnap"], "application/vnd.recordare.musicxml+xml": [".musicxml"], "application/vnd.recordare.musicxml": [".mxl"], "application/vnd.makemusic.notation": [".musx", ".ftmx"] } }
  ],
  "shortcuts": [
    { "name": "사진으로 악보 인식", "url": "./?action=scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "새 악보", "url": "./?action=new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
