<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written test fixture for JSE (tools/tests/mscz.test.js) in the layout of the MuseScore development
     format 5.00: lines are listed in <SpannerMap> and point at chords / measures by <eid>, ties sit in the
     note with startElement / endElement. Not produced by MuseScore. -->
<museScore version="5.00">
  <programVersion>5.0.0</programVersion>
  <programRevision></programRevision>
  <Score>
    <Division>480</Division>
    <metaTag name="workTitle">Fixture Five</metaTag>
    <Part id="1">
      <Staff>
        <eid>st1</eid>
        <StaffType group="pitched">
          <name>stdNormal</name>
          </StaffType>
        </Staff>
      <Instrument id="violin">
        <trackName>Violin</trackName>
        <instrumentId>strings.violin</instrumentId>
        <InstrumentLabel>
          <longName>Violin</longName>
          <shortName>Vn.</shortName>
          </InstrumentLabel>
        <Channel>
          <program value="40"/>
          </Channel>
        </Instrument>
      </Part>
    <Staff id="1">
      <Measure>
        <eid>m1</eid>
        <voice>
          <KeySig>
            <eid>k1</eid>
            <concertKey>-1</concertKey>
            </KeySig>
          <TimeSig>
            <eid>t1</eid>
            <sigN>2</sigN>
            <sigD>4</sigD>
            </TimeSig>
          <Chord>
            <eid>c1</eid>
            <durationType>quarter</durationType>
            <Note>
              <eid>n1</eid>
              <pitch>65</pitch>
              <tpc>13</tpc>
              </Note>
            </Chord>
          <Chord>
            <eid>c2</eid>
            <durationType>quarter</durationType>
            <Note>
              <eid>n2</eid>
              <pitch>70</pitch>
              <tpc>12</tpc>
              </Note>
            </Chord>
          </voice>
        </Measure>
      <Measure>
        <eid>m2</eid>
        <voice>
          <Chord>
            <eid>c3</eid>
            <durationType>quarter</durationType>
            <Note>
              <eid>n3</eid>
              <Tie>
                <startElement>n2</startElement>
                <endElement>n3</endElement>
                <eid>tie1</eid>
                <track>0</track>
                </Tie>
              <pitch>70</pitch>
              <tpc>12</tpc>
              </Note>
            </Chord>
          <Chord>
            <eid>c4</eid>
            <durationType>quarter</durationType>
            <Note>
              <eid>n4</eid>
              <pitch>72</pitch>
              <tpc>14</tpc>
              </Note>
            </Chord>
          <BarLine>
            <subtype>end</subtype>
            <eid>b1</eid>
            </BarLine>
          </voice>
        </Measure>
      </Staff>
    <SpannerMap>
      <Slur>
        <startElement>c1</startElement>
        <endElement>c2</endElement>
        <eid>s1</eid>
        <track>0</track>
        </Slur>
      <HairPin>
        <subtype>1</subtype>
        <track2>0</track2>
        <startTick>1/2</startTick>
        <ticks>1/2</ticks>
        <eid>h1</eid>
        <track>0</track>
        </HairPin>
      <Volta>
        <endHookType>1</endHookType>
        <beginText>1.</beginText>
        <endings>1</endings>
        <startElement>m2</startElement>
        <endElement>m2</endElement>
        <eid>v1</eid>
        <track>0</track>
        </Volta>
      </SpannerMap>
    </Score>
  </museScore>
